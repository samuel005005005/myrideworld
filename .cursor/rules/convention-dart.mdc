### Dominio - Caso de Uso

```dart
// features/usuarios/domain/usecases/obtener_usuario.dart

import 'package:dartz/dartz.dart';
import 'package:equatable/equatable.dart';

import '../../../../core/error/failures.dart';
import '../../../../core/usecases/usecase.dart';
import '../entities/usuario.dart';
import '../repositories/usuario_repository.dart';

class ObtenerUsuario implements UseCase<Usuario, ObtenerUsuarioParams> {
  final UsuarioRepository repository;

  ObtenerUsuario(this.repository);

  @override
  Future<Either<Failure, Usuario>> call(ObtenerUsuarioParams params) {
    return repository.obtenerPorId(params.id);
  }
}

class ObtenerUsuarioParams extends Equatable {
  final String id;

  const ObtenerUsuarioParams({required this.id});

  @override
  List<Object?> get props => [id];
}
