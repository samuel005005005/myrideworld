### Data - DataSource

```dart
// features/usuarios/data/datasources/usuario_remote_datasource.dart

import 'package:dio/dio.dart';

import '../../../../core/error/exceptions.dart';
import '../models/usuario_model.dart';

abstract class UsuarioRemoteDataSource {
  Future<UsuarioModel> obtenerPorId(String id);
  Future<List<UsuarioModel>> listarTodos();
  Future<UsuarioModel> crear(String nombre, String email);
}

class UsuarioRemoteDataSourceImpl implements UsuarioRemoteDataSource {
  final Dio dio;

  UsuarioRemoteDataSourceImpl({required this.dio});

  @override
  Future<UsuarioModel> obtenerPorId(String id) async {
    try {
      final response = await dio.get('/api/usuarios/$id');
      return UsuarioModel.fromJson(response.data as Map<String, dynamic>);
    } on DioException catch (e) {
      throw ServerException(
        e.response?.statusMessage ?? 'Error al obtener usuario',
      );
    }
  }

  @override
  Future<List<UsuarioModel>> listarTodos() async {
    try {
      final response = await dio.get('/api/usuarios');
      final lista = response.data as List<dynamic>;
      return lista
          .map((json) => UsuarioModel.fromJson(json as Map<String, dynamic>))
          .toList();
    } on DioException catch (e) {
      throw ServerException(
        e.response?.statusMessage ?? 'Error al listar usuarios',
      );
    }
  }

  @override
  Future<UsuarioModel> crear(String nombre, String email) async {
    try {
      final response = await dio.post(
        '/api/usuarios',
        data: {'nombre': nombre, 'email': email},
      );
      return UsuarioModel.fromJson(response.data as Map<String, dynamic>);
    } on DioException catch (e) {
      throw ServerException(
        e.response?.statusMessage ?? 'Error al crear usuario',
      );
    }
  }
}
```

### Data - Implementación del Repositorio

```dart
// features/usuarios/data/repositories/usuario_repository_impl.dart

import 'package:dartz/dartz.dart';

import '../../../../core/error/exceptions.dart';
import '../../../../core/error/failures.dart';
import '../../../../core/network/network_info.dart';
import '../../domain/entities/usuario.dart';
import '../../domain/repositories/usuario_repository.dart';
import '../datasources/usuario_local_datasource.dart';
import '../datasources/usuario_remote_datasource.dart';

class UsuarioRepositoryImpl implements UsuarioRepository {
  final UsuarioRemoteDataSource remoteDataSource;
  final UsuarioLocalDataSource localDataSource;
  final NetworkInfo networkInfo;

  UsuarioRepositoryImpl({
    required this.remoteDataSource,
    required this.localDataSource,
    required this.networkInfo,
  });

  @override
  Future<Either<Failure, Usuario>> obtenerPorId(String id) async {
    if (await networkInfo.isConnected) {
      try {
        final remoteUsuario = await remoteDataSource.obtenerPorId(id);
        await localDataSource.cachearUsuario(remoteUsuario);
        return Right(remoteUsuario);
      } on ServerException catch (e) {
        return Left(ServerFailure(e.mensaje));
      }
    } else {
      try {
        final localUsuario = await localDataSource.obtenerUsuario(id);
        return Right(localUsuario);
      } on CacheException {
        return const Left(CacheFailure());
      }
    }
  }

  @override
  Future<Either<Failure, List<Usuario>>> listarTodos() async {
    try {
      final usuarios = await remoteDataSource.listarTodos();
      return Right(usuarios);
    } on ServerException catch (e) {
      return Left(ServerFailure(e.mensaje));
    }
  }

  // ... demás métodos
}
```

### Presentación - Providers (Riverpod)

```dart
// features/usuarios/presentation/providers/usuarios_provider.dart

import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../../../core/providers/core_providers.dart';
import '../../data/datasources/usuario_remote_datasource.dart';
import '../../data/datasources/usuario_local_datasource.dart';
import '../../data/repositories/usuario_repository_impl.dart';
import '../../domain/repositories/usuario_repository.dart';
import '../../domain/usecases/obtener_usuario.dart';
import '../../domain/usecases/listar_usuarios.dart';
import '../../domain/usecases/crear_usuario.dart';

// === Data Sources ===
final usuarioRemoteDataSourceProvider = Provider<UsuarioRemoteDataSource>((ref) {
  return UsuarioRemoteDataSourceImpl(dio: ref.watch(dioProvider));
});

final usuarioLocalDataSourceProvider = Provider<UsuarioLocalDataSource>((ref) {
  return UsuarioLocalDataSourceImpl();
});

// === Repository ===
final usuarioRepositoryProvider = Provider<UsuarioRepository>((ref) {
  return UsuarioRepositoryImpl(
    remoteDataSource: ref.watch(usuarioRemoteDataSourceProvider),
    localDataSource: ref.watch(usuarioLocalDataSourceProvider),
    networkInfo: ref.watch(networkInfoProvider),
  );
});

// === Use Cases ===
final obtenerUsuarioUseCaseProvider = Provider<ObtenerUsuario>((ref) {
  return ObtenerUsuario(ref.watch(usuarioRepositoryProvider));
});

final listarUsuariosUseCaseProvider = Provider<ListarUsuarios>((ref) {
  return ListarUsuarios(ref.watch(usuarioRepositoryProvider));
});

final crearUsuarioUseCaseProvider = Provider<CrearUsuario>((ref) {
  return CrearUsuario(ref.watch(usuarioRepositoryProvider));
});
```

### Presentación - Controller (AsyncNotifier)

```dart
// features/usuarios/presentation/controllers/usuarios_controller.dart

import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/entities/usuario.dart';
import '../../domain/usecases/listar_usuarios.dart';
import '../../domain/usecases/crear_usuario.dart';
import '../../../../core/usecases/usecase.dart';
import '../providers/usuarios_provider.dart';

/// Provider del controller de lista de usuarios
final usuariosControllerProvider =
    AsyncNotifierProvider<UsuariosController, List<Usuario>>(
  UsuariosController.new,
);

class UsuariosController extends AsyncNotifier<List<Usuario>> {
  @override
  Future<List<Usuario>> build() async {
    return _cargarUsuarios();
  }

  Future<List<Usuario>> _cargarUsuarios() async {
    final listarUsuarios = ref.read(listarUsuariosUseCaseProvider);
    final resultado = await listarUsuarios(NoParams());

    return resultado.fold(
      (failure) => throw Exception(failure.mensaje),
      (usuarios) => usuarios,
    );
  }

  Future<void> refrescar() async {
    state = const AsyncLoading();
    state = await AsyncValue.guard(_cargarUsuarios);
  }

  Future<void> crearUsuario({
    required String nombre,
    required String email,
  }) async {
    final crearUsuarioUseCase = ref.read(crearUsuarioUseCaseProvider);
    final resultado = await crearUsuarioUseCase(
      CrearUsuarioParams(nombre: nombre, email: email),
    );

    resultado.fold(
      (failure) => state = AsyncError(failure.mensaje, StackTrace.current),
      (nuevoUsuario) {
        final listaActual = state.valueOrNull ?? [];
        state = AsyncData([...listaActual, nuevoUsuario]);
      },
    );
  }
}
```

### Presentación - Provider para detalle (Family)

```dart
// features/usuarios/presentation/providers/usuario_detalle_provider.dart

import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/entities/usuario.dart';
import '../../domain/usecases/obtener_usuario.dart';
import 'usuarios_provider.dart';

/// Provider para obtener un usuario por ID (usa family para parámetro)
final usuarioDetalleProvider =
    FutureProvider.family<Usuario, String>((ref, id) async {
  final obtenerUsuario = ref.read(obtenerUsuarioUseCaseProvider);
  final resultado = await obtenerUsuario(ObtenerUsuarioParams(id: id));

  return resultado.fold(
    (failure) => throw Exception(failure.mensaje),
    (usuario) => usuario,
  );
});
```

### Presentación - Page

```dart
// features/usuarios/presentation/pages/usuarios_page.dart

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../controllers/usuarios_controller.dart';
import '../widgets/usuario_card.dart';
import '../../../../shared/widgets/loading_widget.dart';
import '../../../../shared/widgets/error_widget.dart' as app;

class UsuariosPage extends ConsumerWidget {
  const UsuariosPage({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final usuariosAsync = ref.watch(usuariosControllerProvider);

    return Scaffold(
      appBar: AppBar(title: const Text('Usuarios')),
      body: usuariosAsync.when(
        loading: () => const LoadingWidget(),
        error: (error, stack) => app.ErrorWidget(
          mensaje: error.toString(),
          onReintentar: () {
            ref.read(usuariosControllerProvider.notifier).refrescar();
          },
        ),
        data: (usuarios) => RefreshIndicator(
          onRefresh: () {
            return ref.read(usuariosControllerProvider.notifier).refrescar();
          },
          child: ListView.builder(
            itemCount: usuarios.length,
            itemBuilder: (context, index) {
              return UsuarioCard(usuario: usuarios[index]);
            },
          ),
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _mostrarFormularioCrear(context),
        child: const Icon(Icons.add),
      ),
    );
  }

  void _mostrarFormularioCrear(BuildContext context) {
    // Navegar a formulario de creación
  }
}
