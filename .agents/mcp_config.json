{
  "mcpServers": {
    "triptap-mongodb": {
      "command": "npx",
      "args": [
        "tsx",
        "tools/mcp-mongodb/src/index.ts"
      ],
      "cwd": "tools/mcp-mongodb",
      "env": {}
    },
    "stitch": {
      "serverUrl": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    }
  }
}
