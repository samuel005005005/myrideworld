# Variables para desarrollo / CI (NO se empaquetan en el APK/IPA).
# Uso (obligatorio):
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Sin API_BASE_URL / SOCKET_URL la app falla al arrancar.
# Nota: API_BASE_URL incluye el prefijo /api (Dio del conductor).
#
# Ejemplos:
#   Emulador Android → http://10.0.2.2:3000/api  y SOCKET sin /api
#   VM HTTPS → https://dev.triptapmedia.com:8444/api

API_BASE_URL=
SOCKET_URL=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Backend (en backend/.env) para enviar push:
# FIREBASE_SERVICE_ACCOUNT_JSON='{...service account JSON...}'
# o GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/serviceAccount.json
#
# Android app id Firebase: com.myriderd.com (ver google-services.json)
