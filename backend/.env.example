# Entorno
NODE_ENV=development
PORT=3000

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password_here
DB_NAME=myride_mvp

# Seguridad (obligatorios). Copiá a `.env` y cambiá los valores.
# Login admin usa el ADMIN_PASSWORD de tu `.env` real (no este example),
# después de `npm run seed` (el seed sincroniza el hash).
JWT_SECRET=cambia-este-secreto-largo
ADMIN_EMAIL=admin@myride.com
ADMIN_PASSWORD=cambia-admin-password
BATCH_SECRET=cambia-batch-secret

# CORS: lista separada por comas, o * para desarrollo
CORS_ORIGINS=*