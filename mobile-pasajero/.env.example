# Variables para desarrollo / CI (NO se empaquetan en el APK/IPA).
# Uso:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# En debug sin defines, AppEnv usa defaults de emulador/simulador.
#
# URLs según dispositivo:
#   Emulador Android → http://10.0.2.2:3000
#   Teléfono físico (Wi‑Fi) → http://<IP-LAN-de-tu-Mac>:3000
#   USB + adb reverse → http://127.0.0.1:3000
#     adb reverse tcp:3000 tcp:3000

API_BASE_URL=http://10.0.2.2:3000
SOCKET_URL=http://10.0.2.2:3000
OSRM_BASE_URL=https://router.project-osrm.org
