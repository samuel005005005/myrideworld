# Variables para desarrollo / CI (NO se empaquetan en el APK/IPA).
# Uso (obligatorio):
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Sin API_BASE_URL / SOCKET_URL / OSRM_BASE_URL la app falla al arrancar.
#
# Ejemplos de URL:
#   Emulador Android → http://10.0.2.2:3000
#   Teléfono físico (Wi‑Fi) → http://<IP-LAN>:3000
#   VM HTTPS → https://dev.triptapmedia.com:8444

API_BASE_URL=
SOCKET_URL=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Solo debug (kDebugMode). Misma zona que el conductor para ver flota en el mapa.
# GPS_OVERRIDE_LAT=18.5820
# GPS_OVERRIDE_LNG=-68.3971
